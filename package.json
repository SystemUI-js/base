{
  "name": "sysui-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "System UI 基础包与 Expo 示例应用工作区",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "yarn workspace @system-ui-js/expo-demo dev",
    "dev:demo": "yarn dev",
    "build": "yarn build:base",
    "build:base": "yarn workspace @system-ui-js/base build",
    "check:expo": "yarn workspace @system-ui-js/expo-demo validate",
    "pack:base": "yarn workspace @system-ui-js/base pack:check",
    "validate": "yarn lint && yarn typecheck && yarn build:base && yarn pack:base && yarn check:expo",
    "typecheck": "yarn build:base && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
