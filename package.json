{
  "name": "@system-ui-js/base",
  "version": "0.1.0",
  "description": "System UI 基础包与 Window Demo 展示站",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:demo": "vite --config vite.config.ts",
    "build": "yarn build:lib && yarn build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -p tsconfig.app.json && vite build --config vite.config.ts",
    "preview:demo": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "pw:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@system-ui-js/chameleon": "file:.yalc/@system-ui-js/chameleon",
    "@system-ui-js/file-system-browser": "file:.yalc/@system-ui-js/file-system-browser",
    "@system-ui-js/file-system-browser-workspace": "file:.yalc/@system-ui-js/file-system-browser-workspace",
    "@system-ui-js/file-system-plugin-memory": "file:.yalc/@system-ui-js/file-system-plugin-memory",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.61.0",
    "rollup-plugin-css-only": "^4.5.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.6"
  }
}
