{
  "name": "@system-ui-js/base",
  "version": "0.1.0",
  "description": "System UI 基础包，提供可在 Web 与 Expo 中消费的窗口基础能力",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.native.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.native.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/index.native.ts --format esm --out-dir dist --clean --external react --external react-dom --external react-native --external @system-ui-js/chameleon && tsc -p tsconfig.build.json && cp src/styles/base.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "yarn build && yarn pack --filename ../../package.tgz && rm -f ../../package.tgz"
  },
  "dependencies": {
    "@system-ui-js/chameleon": "0.2.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.83.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
