+                    return {
+                        ...rest,
+                        state,
+                        x: savedGeometry.x,
+                        y: savedGeometry.y,
+                        width: savedGeometry.width,
+                        height: savedGeometry.height
+                    };
+                }
+
+                return { ...window, state };
+            })
+        }));
+        return {
+            ...prev,
+            screens: updatedScreens
+        };
+    }),
 })));
 
